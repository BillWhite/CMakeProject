ECHO=
# options may be followed by one colon to indicate they have a required argument
# SHORT_OPTS here has u, h, d and e which take no arguments, and
#            D, t and f which take one argument.
# LONG_OPTS  lists the long options, with two dashes. This example takes
#            user, host, debug and echo which take no arguments, and
#            domain-list, cipher and outfile which all take one argument.
# SHORT_OPTS="uhdeD:t:f:"
# LONG_OPTS=" user,host,debug,echo,domain-list:,cipher:,outfile:
SHORT_OPTS="G:D:h"
LONG_OPTS="cpp-compiler,c-compiler,short-build-dir,no-compile-commands-export,roll-build-dir,no-roll-build-dir"
if ! options=$(getopt -u -o "$SHORT_OPTS" -l "$LONG_OPTS" -- "$@")
then
    # something went wrong, getopt will put out an error message for us
    exit 1
fi

set -- $options

# Set state variables here.
PROGRAM_NAME="$0"
GENERATOR="{{cookiecutter.cmake_generator}}"
BUILD_TYPE=Debug
EXPORT_COMPILE_COMMANDS="-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
ROLL_BUILD_DIR=YES
CXX=c++
CC=cc

usage() {
    echo "Usage: $0 [options...] source_directory [build_directory]"
    echo "Options:"
    echo "  -G generator      Set the CMake generator type."
    echo "  -D NAME=Value     Define a CMake value."
    echo "  --build-type type Use the given build type.  The usual"
    echo "                    CMake build types are possible: Debug,"
    echo "                    Release, etc. The default is Debug."
    echo "  --short-build-dir We usually append the multiarch triple to the build"
    echo "                    type name to get the build directory name."
    echo "                    We use the definition of CXX for this, but"
    echo "                    the notion of build triple is not actually"
    echo "                    very well defined. So you may find it better"
    echo "                    to just use the build type. In any case,"
    echo "                    if the build dir is given on the command line"
    echo "                    it is used as given exactly."
    echo "  --no-compile-commands-export"
    echo "                    Don't export a compile_commands.json file."
    echo "  --roll-build-dir  If an old build directory exists, then"
    echo "                    roll it up.  Old directories are stored"
    echo "                    as, say, \"Debug.~n~\", where \"n\" is"
    echo "                    a number in increasing age order.  Otherwise,"
    echo "                    and by default, they are just deleted."
    echo "  --no-roll-build-dir"
    echo "                    Don't roll the build directories."
    echo "  --cpp-compiler pathname"
    echo "                    Set the name of the C++ compiler."
    echo "  --c-compiler pathname"
    echo "                    Set the name of the C compiler."
    echo "  --help            Help me, I'm melting."
    echo ""
}

find_project_root() {
    local LAST_DIR="/dev/null"
    local THIS_DIR="$(/bin/pwd)"
    while [ "$THIS_DIR" != "$LAST_DIR" ]; do
	CANDIDATE="$THIS_DIR/.projectroot"
	if [ -f "$CANDIDATE" ] ; then
	    echo "$THIS_DIR"
        return
	fi
	LAST_DIR="$THIS_DIR"
	THIS_DIR="$(cd $THIS_DIR/..; /bin/pwd)"
    done
}

find_source_dir() {
    local CAND="$(find_project_root)"
    cd "$CAND"
    if [ -n "$CAND" ] ; then
       for file in . *; do
           if [ -d "$file" ] && [ -f "$file/.sourceroot" ] ; then
               echo "$file"
               return
           fi
       done
    fi
}

rolldir() {
    idx=0
    while [ $(($idx < 100)) = 1 ] && [ -d "$1.~${idx}~" ] ; do
	    idx=$(( $idx + 1 ))
    done
    while [ $idx -gt 0 ] ; do
	    prev=$(( $idx - 1))
	    mv "$1.~${prev}~" "$1.~${idx}~"
        idx=$(( $idx - 1 ))
    done
    if [ -d "$1" ] ; then
	    mv "$1" "$1.~0~"
    fi
}

process_args() {
    echo "$@"
    while [ $# -gt 0 ]
    do
        case $1 in
            "--cpp-compiler")
                shift
                export CXX="$1"
                shift
                ;;
            "--c-compiler")
                shift
                export CC="$1"
                shift
                ;;
	        "--no-roll-build-dir")
		        shift
		        ROLL_BUILD_DIR=
		        ;;
	        "--roll-build-dir")
		        shift
		        ROLL_BUILD_DIR=YES
		        ;;
            "--no-compile-commands-export")
		        EXPORT_COMPILE_COMMANDS=""
		        shift
		        ;;
	        "--build-type")
		        shift
		        BUILD_TYPE="$1"
		        shift
		        ;;
            "--short-build-dir")
                SHORT_BUILD_DIR=YES
                shift
                ;;
	        "-G")
		        shift
		        GENERATOR="$1"
		        shift
		        ;;
	        "-D")
		        shift   
		        DFN = "$1"
		        DEFINITIONS="$DEFINITIONS -D$DFN"
		        shift
		        ;;
	        --help)
		        usage
	            return 100
		        ;;
            (--)
                shift
                break
                ;;
            "-*")
		        echo "$0: Unknown comand line parameter \"$1\"" 1.>2
		        usage
		        return 100
		        ;;
            (--) break;;
        esac
    done    
    if [ -n "$1" ] ; then
		if [ -z "$SOURCE_DIR" ] ; then
		    SOURCE_DIR="$1"
		    shift;
		elif [ -z "$BUILD_DIR" ] ; then
		    BUILD_DIR="$1"
		    shift
		else
		    echo "$PROGRAM_NAME: Unknown parameter \"$1\""
		    usage
		    return 100
        fi
    fi
}

if ! process_args "$@"; then
    exit $?
fi

if [ -z "$SOURCE_DIR" ] ; then
    SOURCE_DIR="$(find_source_dir)"
fi
if [ -z "$SOURCE_DIR" ] ; then
    echo "$0: No source directory specified."
    usage
    exit 100
fi


if [ ! -d "$SOURCE_DIR" ] ; then
    echo "$0: Putative source directory \"$SOURCE_DIRECTORY\" is not a directory after all."
    exit 100
fi
SOURCE_DIR=$(cd $SOURCE_DIR; /bin/pwd)
DEFINITIONS="$DEFINITIONS $EXPORT_COMPILE_COMMANDS"

case "$BUILD_TYPE" in
    "Debug"|"Release"|"RelWithDebInfo"|"MinSizeRel")
	    if [ -z "$BUILD_DIR" ] ; then
            if [ -n "${SHORT_BUILD_DIR}" ] ; then
	            BUILD_DIR=$BUILD_TYPE
            else
                BUILD_ARCH="$(${CXX} --print-multiarch)"
                BUILD_DIR="$BUILD_TYPE@$BUILD_ARCH"
            fi
	    fi
	    DEFINITIONS="$DEFINITIONS -DCMAKE_BUILD_TYPE=$BUILD_TYPE"
	    ;;
    *)
	    echo "$0: Unknown build type $BUILD_TYPE"
	    exit 100
	    ;;
esac
if [ -z "$BUILD_DIR" ] ; then
    set -x
    if [ -n "$SHORT_BUILD_DIR" ] ; then
        BUILD_DIR="$BUILD_TYPE"
    else
        BUILD_ARCH="$(${CXX} --print-multiarch)"
        BUILD_DIR="${BUILD_DIR}@${BUILD_ARCH}"
    fi
fi
if [ -n "$ROLL_BUILD_DIR" ] ; then
    rolldir "$BUILD_DIR"
else
    /bin/rm -rf "$BUILD_DIR"
fi
if ! mkdir -p "$BUILD_DIR" ; then
    echo "$0: Cannot make build directory $BUILD_DIR"
    exit 100
fi
CREATED=YES
#
# CD to the build directory and generate the build artifacts.
#
(cd "$BUILD_DIR"; \
    CC=${CC} CXX=${CXX} cmake -G "$GENERATOR" $DEFINITIONS "$SOURCE_DIR";
    touch ".buildroot($BUILD_TYPE)")
