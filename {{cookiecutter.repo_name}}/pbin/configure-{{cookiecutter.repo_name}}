#!/bin/sh 
GENERATOR="{{cookiecutter.cmake_generator}}"
usage() {
    echo "Usage: $0 [options...] source_directory [build_directory]"
    echo "Options:"
    echo "  --init            Initialize the build directory."
    echo "  --help            Print this help message."
}

while [ -z "$DONE" ] ; do
    case "$1" in
	--#)
	    shift
	    set -x
	    ;;
	--init)
	    INIT=YES
	    shift
	    ;;
	--help)
	    usage
	    exit 100
	    ;;
	-G)
	    shift
	    GENERATOR="$1"
	    shift
	    ;;
	-D*)
	    DFN=$(echo "$1" | sed 's/^-D//')
	    if [ -z "$DFN" ] ; then
		shift
		DFN = "$1"
	    fi
	    DEFINITIONS="$DEFINITIONS -D$DFN"
	    shift
	    ;;
	-*)
	    echo "$0: Unknown comand line parameter \"$1\""
	    usage
	    exit 100
	    ;;
	*)
	    DONE=YES
	    ;;
    esac
done

if [ -z "$1" ] ; then
  echo "$0: No source directory specified."
  usage
  exit 100
else
  SOURCE_FOLDER="$1"
fi
if [ -n "$2" ] ; then
  if [ ! -d "$2" ] ; then
      mkdir -p "$2" || exit 100
      BUILD_DIR="$2"
      CREATED=YES
  fi
  cd "$2"
fi
if [ -n "$INIT" ]; then
    if [ ! -f CMakeCache.txt ] && [ -z "$CREATED" ] ; then
	echo "$0: --init can only be specified when cmake has already been run."
	exit 100
    fi
    rm -rf *
fi

CC={{cookiecutter.c_compiler}} CXX={{cookiecutter.cpp_compiler}} cmake -G "$GENERATOR" $DEFINITIONS "$SOURCE_FOLDER"
