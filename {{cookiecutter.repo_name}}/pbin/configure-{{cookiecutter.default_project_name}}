#!/bin/sh 
GENERATOR="{{cookiecutter.cmake_generator}}"
usage() {
    echo "Usage: $0 [options...] source_directory [build_directory]"
    echo "Options:"
    echo "  --init            Initialize the build directory."
    echo "  -G generator      Set the CMake generator type."
    echo "  -D NAME=Value     Define a CMake value."
    echo "  -DNAME=Value      Define a CMake value (one argument.)"
    echo "  --help            Print this help message."
}

while [ -z "$DONE" ] ; do
    case "$1" in
	--#)
	    shift
	    set -x
	    ;;
	--init)
	    INIT=YES
	    shift
	    ;;
	--help)
	    usage
	    exit 100
	    ;;
	-G)
	    shift
	    GENERATOR="$1"
	    shift
	    ;;
	-D*)
	    DFN=$(echo "$1" | sed 's/^-D//')
	    if [ -z "$DFN" ] ; then
		shift
		DFN = "$1"
	    fi
	    DEFINITIONS="$DEFINITIONS -D$DFN"
	    shift
	    ;;
	-*)
	    echo "$0: Unknown comand line parameter \"$1\""
	    usage
	    exit 100
	    ;;
	*)
	    DONE=YES
	    ;;
    esac
done

if [ -z "$1" ] ; then
  echo "$0: No source directory specified."
  usage
  exit 100
else
  SOURCE_DIR="$1"
fi
if [ ! -d "$SOURCE_DIR" ] ; then
  echo "$0: Putative source directory \"$SOURCE_DIRECTORY\" is not a directory after all."
  exit 100
fi
SOURCE_DIR=$(cd $SOURCE_DIR; /bin/pwd)

if [ -z "$2" ] ; then
  BUILD_DIR=$(/bin/pwd)
else
  if [ ! -d "$2" ] ; then
      BUILD_DIR="$2"
      mkdir -p "$BUILD_DIR" || exit 100
      CREATED=YES
  fi
fi

cd "$BUILD_DIR"
if [ -n "$INIT" ]; then
    if [ ! -f CMakeCache.txt ] && [ -z "$CREATED" ] ; then
	echo "$0: --init can only be specified when cmake has already been run."
	exit 100
    fi
    rm -rf *
fi

CC={{cookiecutter.c_compiler}} CXX={{cookiecutter.cpp_compiler}} cmake -G "$GENERATOR" $DEFINITIONS "$SOURCE_DIR"
